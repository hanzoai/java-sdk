#!/bin/sh
# README.md prints the coordinate a reader pastes, so every version it names is
# the one hanzo-java-cloud/build.gradle publishes. It named 8.5.89, which Maven
# Central never served, while Central served 8.5.156.
set -eu
cd "$(dirname "$0")/.."

want=$(sed -n "s/^version = '\(.*\)'/\1/p" hanzo-java-cloud/build.gradle)
[ -n "$want" ] || { echo "no version in hanzo-java-cloud/build.gradle" >&2; exit 1; }

named=$( {
  grep -oE 'ai\.hanzo:hanzo-java-cloud:[0-9][0-9A-Za-z.+-]*' README.md | sed 's/.*://'
  grep -oE '<version>[^<]+</version>' README.md | sed -E 's#</?version>##g'
} | sort -u)
[ -n "$named" ] || { echo "README.md names no version of ai.hanzo:hanzo-java-cloud" >&2; exit 1; }

wrong=$(printf '%s\n' "$named" | grep -vxF "$want" || true)
[ -z "$wrong" ] || { echo "README.md names $(echo $wrong); this build publishes $want" >&2; exit 1; }
echo "README.md names $want"

# Every API class a README snippet names is one this build generates. The
# quickstart called KeysApi and ModelsApi, which neither this tree nor any
# published jar has had, so the first thing a reader pasted did not compile.
api=hanzo-java-cloud/src/main/java/ai/hanzo/cloud/api
missing=$(grep -oE '\b[A-Z][A-Za-z0-9]*Api\b' README.md | sort -u | while read -r class; do
  [ -f "$api/$class.java" ] || printf ' %s' "$class"
done)
[ -z "$missing" ] || { echo "README.md names$missing; $api has no such class" >&2; exit 1; }
echo "README.md names only generated API classes"
