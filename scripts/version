#!/bin/sh
# Print the version hanzo-java-cloud/build.gradle publishes. The one reader of
# it: hanzoai/ci's cut (hanzo.yml client.version), the readme gate and the
# release workflow all ask this script, so none of them parses the file its own way.
set -eu
cd "$(dirname "$0")/.."
sed -n "s/^version = '\(.*\)'/\1/p" hanzo-java-cloud/build.gradle
